{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly discoverable directory profile for real-time multi-user search, gender (Female/Male), age, call approval preference, and presence.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "userHandle": { "type": "string" },
        "photoUrl": { "type": "string" },
        "gender": { "type": "string", "enum": ["", "Female", "Male"] },
        "age": { "type": "integer" },
        "requireCallApproval": { "type": "boolean" },
        "onlineStatus": { "type": "string", "enum": ["online", "offline"] },
        "directoryVisible": { "type": "boolean" },
        "accountType": { "type": "string", "enum": ["google"] },
        "profileVisibility": { "type": "string", "enum": ["contacts", "private", "public"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "displayName", "userHandle", "photoUrl", "onlineStatus",
        "directoryVisible", "accountType", "profileVisibility", "createdAt", "updatedAt"
      ]
    },
    "UserPrivateSettings": {
      "title": "UserPrivateSettings",
      "description": "Owner-only private settings and PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "appLockEnabled": { "type": "boolean" },
        "autoRecordCalls": { "type": "boolean" },
        "notificationAlert": { "type": "boolean" },
        "recordingQuality": { "type": "string", "enum": ["HD 720p", "FHD 1080p", "Audio Only"] },
        "retentionDays": { "type": "integer" },
        "blockedUids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "email", "appLockEnabled", "autoRecordCalls", "notificationAlert",
        "recordingQuality", "retentionDays", "blockedUids", "createdAt", "updatedAt"
      ]
    },
    "TrustedContact": {
      "title": "TrustedContact",
      "description": "Multi-user contact connection with mutual Call Approval status.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "targetUid": { "type": "string" },
        "memberUids": { "type": "array", "items": { "type": "string" } },
        "requesterName": { "type": "string" },
        "requesterHandle": { "type": "string" },
        "contactName": { "type": "string" },
        "contactHandle": { "type": "string" },
        "avatarKey": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "pending", "blocked"] },
        "presenceState": { "type": "string", "enum": ["online", "offline", "away"] },
        "lastActivityText": { "type": "string" },
        "lastActivityType": { "type": "string", "enum": ["video_call", "audio_recording", "message", "audio_call"] },
        "callApproved": { "type": "boolean" },
        "callApprovalRequestedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "targetUid", "memberUids", "requesterName", "requesterHandle",
        "contactName", "contactHandle", "avatarKey", "status", "presenceState",
        "lastActivityText", "lastActivityType", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public directory profile document."
    },
    "/users/{uid}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateSettings" },
      "description": "Owner-only private settings."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/TrustedContact" },
      "description": "Shared contact document with mutual Call Approval."
    }
  }
}
